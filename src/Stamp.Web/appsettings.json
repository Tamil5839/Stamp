{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",

  "App": {
    "BaseUrl": ""
  },

  "Database": {
    "Provider": "Sqlite",
    "AutoMigrate": true
  },
  "ConnectionStrings": {
    "Stamp": "Data Source=App_Data/stamp.db"
  },

  "Payments": {
    "Provider": "Stripe"
  },
  "Stripe": {
    "SecretKey": "",
    "PublishableKey": "",
    "WebhookSecret": "",
    "ConnectWebhookSecret": "",
    "ConnectAccountCountry": ""
  },

  "Email": {
    "Provider": "Resend",
    "From": "Stamp <no-reply@example.com>",
    "ResendApiKey": ""
  },

  "Stamps": {
    "ReplyWindow": "6.00:00:00",
    "PlatformFeePercent": 10,
    "AbandonUnpaidAfter": "1.00:00:00",
    "SenderRateLimit": 5,
    "SenderRateLimitWindow": "01:00:00"
  },
  "Auth": {
    "MagicLinkLifetime": "00:15:00",
    "MagicLinksPerEmailPerHour": 5
  },
  "Jobs": {
    "Expiry": {
      "Enabled": true,
      "Interval": "01:00:00",
      "InitialDelay": "00:00:30"
    }
  },
  "RateLimits": {
    "Window": "00:10:00",
    "SendStampPerIp": 10,
    "LoginPerIp": 10
  }
}
